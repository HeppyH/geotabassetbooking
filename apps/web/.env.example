# Build-time settings for the frontend (copy to apps/web/.env.local for local use).
# Everything prefixed VITE_ is embedded in the public bundle: never put secrets here.
# The native MyGeotab Add-In needs no API URL: there is no external backend.

# Label shown only in the offline simulation. The native runtime takes the tenant from
# the MyGeotab session and validates it against the approved allowlist (empty by default).
VITE_GEOTAB_DATABASE=opex_trial
